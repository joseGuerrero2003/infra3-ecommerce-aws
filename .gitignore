# ============================================================
# Environment & Secrets — NEVER commit these
# ============================================================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials
credentials.json
secrets.json
.aws/credentials
.aws/config

# ============================================================
# AWS / CloudFormation
# ============================================================
# Packaged CloudFormation templates (generated artifacts)
*.packaged.yaml
*.packaged.template
cdk.out/
samconfig.toml
# Actual AWS credentials files
aws-exports.js
amplify/
# Production parameter files (may contain real secrets)
cloudformation/parameters/prod.json
cloudformation/parameters/staging.json

